{
  "target_image_size": [256, 256],
  "color_mode": "Grayscale (1-channel)",
  "pixel_intensity_normalization": {
    "mean": [0.485],
    "std": [0.229],
    "scale_range": "[0.0, 1.0]"
  },
  "augmentations": {
    "horizontal_flip_prob": 0.5,
    "rotation_range_deg": [-15, 15],
    "shift_limit": 0.06,
    "scale_limit": 0.10,
    "brightness_contrast_prob": 0.5
  },
  "postprocessing": {
    "sigmoid_threshold": 0.50,
    "connected_components_filtering": {
      "min_area_pixels": 250,
      "max_components_kept": 1,
      "aspect_ratio_min": 2.2,
      "aspect_ratio_max": 8.5
    },
    "pca_long_axis_extraction": {
      "confidence_threshold": 0.75,
      "endpoint_extrema_method": "principal_eigenvector_projection"
    }
  }
}
