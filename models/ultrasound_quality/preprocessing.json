{
  "pipeline_name": "EfficientNet_Ultrasound_Preprocessing_v1",
  "input_formats": ["PNG", "JPG", "JPEG", "DICOM_FRAME"],
  "target_resolution": [224, 224],
  "color_mode": "RGB",
  "interpolation": "bilinear",
  "normalization": {
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "technical_filters": {
    "sharpness_method": "laplacian_variance",
    "sharpness_min_threshold": 35.0,
    "contrast_method": "pixel_standard_deviation",
    "contrast_min_threshold": 25.0,
    "brightness_mean_range": [30.0, 225.0],
    "snr_min_db": 12.0
  },
  "augmentations_training": [
    "RandomHorizontalFlip(p=0.5)",
    "RandomRotation(degrees=(-10, 10))",
    "ColorJitter(brightness=0.1, contrast=0.1)",
    "RandomResizedCrop(size=224, scale=(0.9, 1.0))"
  ]
}
